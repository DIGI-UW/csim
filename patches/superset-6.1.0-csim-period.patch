+import { render, screen, userEvent } from 'spec/helpers/testing-library';
+import { nativeFilters } from 'spec/fixtures/mockNativeFilters';
+import VerticalBar from './Vertical';
+import type { VerticalBarProps } from './types';
+
+jest.mock('./FilterControls/FilterControls', () => ({
+  __esModule: true,
+  default: ({ clearAllTriggers, onClearAllComplete }: Pick<VerticalBarProps, 'clearAllTriggers' | 'onClearAllComplete'>) => (
+    <button type="button" onClick={() => onClearAllComplete?.('hospital')}>
+      {clearAllTriggers?.hospital ? 'Clear pending' : 'Ready'}
+    </button>
+  ),
+}));
+
+// Exercise the vertical sidebar boundary: both the trigger and acknowledgement
+// must reach its controls, including a second clear after an acknowledgement.
+// The browser regression checks the real select's retained hospital and results.
+test('forwards successive clear requests and acknowledgements to vertical controls', async () => {
+  const acknowledge = jest.fn();
+  const props: VerticalBarProps = {
+    actions: null, canEdit: false, dataMaskSelected: {},
+    filterValues: [{ ...nativeFilters.filters['NATIVE_FILTER-e7Q8zKixx'], id: 'hospital' }],
+    chartCustomizationValues: [], isInitialized: true,
+    onSelectionChange: jest.fn(), onPendingCustomizationDataMaskChange: jest.fn(),
+    onClearAllComplete: acknowledge, filtersOpen: true, height: 700,
+    offset: 0, toggleFiltersBar: jest.fn(), width: 240,
+  };
+  const { rerender } = render(<VerticalBar {...props} />, {
+    useRedux: true, useRouter: true, initialState: {
+      dashboardState: { sliceIds: [] }, dashboardInfo: { dash_edit_perm: false },
+      dashboardLayout: { present: {}, past: [], future: [] }, dataMask: {},
+    },
+  });
+  expect(screen.getByRole('button', { name: 'Ready' })).toBeInTheDocument();
+  for (let count = 1; count <= 2; count += 1) {
+    rerender(<VerticalBar {...props} clearAllTriggers={{ hospital: true }} />);
+    await userEvent.click(screen.getByRole('button', { name: 'Clear pending' }));
+    expect(acknowledge).toHaveBeenNthCalledWith(count, 'hospital');
+    rerender(<VerticalBar {...props} clearAllTriggers={{}} />);
+    expect(screen.getByRole('button', { name: 'Ready' })).toBeInTheDocument();
+  }
+});
