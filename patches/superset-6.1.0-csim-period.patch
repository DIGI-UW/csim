+// Opt-in reporting labels: keep typed timestamps for sorting and filtering,
+// while axis labels and hover titles follow the selected grouping.
+// Select real reporting buckets before formatting. Layout must not depend on
+// how often ECharts calls a formatter while measuring and painting labels.
+export function getCsimTickValues(values: number[]): number[] {
+  return [...new Set(values.filter(Number.isFinite))].sort((a, b) => a - b);
+}
+
+export const getCsimPeriodFormatter = (timeGrain?: string) =>
+  new TimeFormatter({
+    id: 'csim_period',
+    label: 'CSiM reporting period',
+    formatFunc: (date: Date) => {
+      const year = date.getUTCFullYear();
+      if (timeGrain === TimeGranularity.YEAR) return String(year);
+      if (timeGrain === TimeGranularity.QUARTER) {
+        return `Q${Math.floor(date.getUTCMonth() / 3) + 1} ${year}`;
+      }
+      return getTimeFormatter('%b %Y')(date);
+    },
+  });
+
