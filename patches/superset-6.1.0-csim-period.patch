+test.each([
+  [TimeGranularity.MONTH, 'Jan 2025'],
+  [TimeGranularity.QUARTER, 'Q1 2025'],
+  [TimeGranularity.YEAR, '2025'],
+])('CSiM uses dashboard grain %s for axes and hover', (grain, label) => {
+  const stamp = Date.UTC(2025, 0, 1);
+  const props = createTestChartProps({
+    formData: {
+      granularity_sqla: 'ds',
+      timeGrainSqla: TimeGranularity.MONTH,
+      extraFormData: { time_grain_sqla: grain },
+      xAxisTimeFormat: 'csim_period',
+      tooltipTimeFormat: 'csim_period',
+    },
+    queriesData: [createTestQueryData([{ __timestamp: stamp, sales: 100 }], {
+      colnames: ['__timestamp', 'sales'],
+      coltypes: [GenericDataType.Temporal, GenericDataType.Numeric],
+    })],
+  });
+  const result = transformProps(props);
+  const axis = result.echartOptions.xAxis as any;
+  expect(axis.axisLabel.formatter(stamp)).toBe(label);
+  expect(result.xValueFormatter(stamp)).toBe(label);
+  // ECharts measures and then draws a tick, calling its formatter repeatedly.
+  expect(axis.axisLabel.formatter(stamp)).toBe(label);
+  expect(axis.axisLabel.showMinLabel).toBe(true);
+  expect(axis.axisLabel.formatter(Date.UTC(2023, 0, 1))).toBe('');
+  expect(axis.axisLabel.formatter(Date.UTC(2027, 0, 1))).toBe('');
+});
