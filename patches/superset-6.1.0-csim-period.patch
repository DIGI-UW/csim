 import {
   getPercentFormatter,
   getXAxisFormatter,
+  getCsimTickValues,
+  getTooltipTimeFormatter,
 } from '../../src/utils/formatters';
 
+test('CSiM ticks keep both ends, all short-range months, and readable long-range spacing', () => {
+  const months = Array.from({ length: 13 }, (_, i) => Date.UTC(2025, 8 + i, 1));
+  const format = (value: number) => String(getXAxisFormatter('csim_period', 'P1M')?.(value));
+  expect(getCsimTickValues(months.slice(0, 6), format, 400)).toEqual(months.slice(0, 6));
+  const narrow = getCsimTickValues(months, format, 400);
+  expect(narrow[0]).toBe(Date.UTC(2025, 8, 1));
+  expect(narrow[narrow.length - 1]).toBe(Date.UTC(2026, 8, 1));
+  expect(narrow.length).toBeLessThan(months.length);
+  narrow.slice(1).forEach((date, i) => expect((date - narrow[i]) / (months[12] - months[0]) * 400).toBeGreaterThanOrEqual(68));
+  expect(getCsimTickValues([months[0], months[0]], format, 400)).toEqual([months[0]]);
+  expect(getCsimTickValues([], format, 400)).toEqual([]);
+});
+
+test.each([
+  ['2025-01-01T00:00:00Z', 'P1M', 'Jan 2025'],
+  ['2025-12-01T00:00:00Z', 'P1M', 'Dec 2025'],
+  ['2025-10-01T00:00:00Z', 'P3M', 'Q4 2025'],
+  ['2026-01-01T00:00:00Z', 'P3M', 'Q1 2026'],
+  ['2025-01-01T00:00:00Z', 'P1Y', '2025'],
+])('CSiM axis and hover agree for %s at %s', (value, grain, expected) => {
+  const date = new Date(value);
+  expect(getXAxisFormatter('csim_period', grain)?.(date)).toBe(expected);
+  expect(getTooltipTimeFormatter('csim_period', grain)(date)).toBe(expected);
+});
