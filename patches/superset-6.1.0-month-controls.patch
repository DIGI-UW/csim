+import { fireEvent, render, screen } from 'spec/helpers/testing-library';
+import CsimMonthRange, { monthRangeMask, readMonthRange, monthCoverage, LAST_COMPLETE_YEAR } from './CsimMonthRange';
+
+test.each([
+  ['2026-02', '2026-03', '2026-02-01 : 2026-04-01'],
+  ['2025-12', '2025-12', '2025-12-01 : 2026-01-01'],
+  ['2024-02', '2024-02', '2024-02-01 : 2024-03-01'],
+])('inclusive months %s through %s preserve both endpoints', (from, through, range) => {
+  expect(monthRangeMask(from, through).extraFormData).toEqual({ time_range: range });
+  expect(readMonthRange(range)).toEqual([from, through]);
+});
+test.each([['', '2026-03'], ['2026-02', ''], ['2026-04', '2026-03'], ['2026-13', '2026-03']])('invalid range %s through %s cannot be applied', (from, through) => {
+  const result = monthRangeMask(from, through);
+  expect(result.filterState?.value).toBeNull();
+  expect(result.filterState?.validateStatus).toBe('error');
+  expect(result.extraFormData).toEqual({});
+});
+test('partial periods describe only the selected months', () => {
+  expect(monthCoverage('2026-02', '2026-03', 'P3M')).toBe('Partial quarters — Q1 2026: Feb 2026 – Mar 2026 only.');
+  expect(monthCoverage('2025-11', '2026-04', 'P3M')).toBe('Partial quarters — Q4 2025: Nov 2025 – Dec 2025 only; Q2 2026: Apr 2026 only.');
+  expect(monthCoverage('2026-02', '2026-03', 'P1Y')).toBe('Partial years — 2026: Feb 2026 – Mar 2026 only.');
+  expect(monthCoverage('2025-01', '2026-12', 'P1Y')).toContain('complete calendar years');
+});
+test('draft months survive invalid input and grouping changes, and clear-all resets them', () => {
+  const setDataMask = jest.fn(), onClearAllComplete = jest.fn();
+  const props = { filterId: 'reporting-months', filterState: { value: '2026-02-01 : 2026-04-01' }, setDataMask, onClearAllComplete };
+  const { rerender } = render(<CsimMonthRange {...props} grain="P3M" />);
+  expect(screen.getByLabelText('From month')).toHaveValue('2026-02');
+  expect(screen.getByLabelText('Through month (inclusive)')).toHaveValue('2026-03');
+  fireEvent.change(screen.getByLabelText('From month'), { target: { value: '2026-04' } });
+  const invalid = setDataMask.mock.calls[0][0];
+  rerender(<CsimMonthRange {...props} {...invalid} grain="P1Y" />);
+  expect(screen.getByLabelText('From month')).toHaveValue('2026-04');
+  expect(screen.getByRole('alert')).toHaveTextContent('on or before');
+  fireEvent.change(screen.getByLabelText('Through month (inclusive)'), { target: { value: '2026-05' } });
+  expect(setDataMask).toHaveBeenLastCalledWith(monthRangeMask('2026-04', '2026-05'));
+  rerender(<CsimMonthRange {...props} {...invalid} clearAllTrigger />);
+  expect(setDataMask).toHaveBeenLastCalledWith(monthRangeMask('', ''));
+  expect(onClearAllComplete).toHaveBeenCalledWith('reporting-months');
+});
+
+
+test.each([
+  ['2026-09-11T19:00:00Z', ['2025-09', '2026-08']],
+  ['2027-01-01T00:00:00Z', ['2026-01', '2026-12']],
+  ['2024-03-01T00:00:00Z', ['2023-03', '2024-02']],
+])('the saved default moves by complete months at %s', (now, expected) => {
+  jest.useFakeTimers().setSystemTime(new Date(now));
+  try {
+    expect(readMonthRange(LAST_COMPLETE_YEAR)).toEqual(expected);
+  } finally {
+    jest.useRealTimers();
+  }
+});
