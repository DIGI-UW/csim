+// Opt-in CSiM labels preserve typed dates while following the reporting grain.
+// Select real reporting buckets before formatting. Layout must not depend on
+// how often ECharts calls a formatter while measuring and painting labels.
+export function getCsimTickValues(
+  values: number[],
+  formatter: (value: number) => string,
+  availableWidth: number,
+): number[] {
+  const dates = [...new Set(values.filter(Number.isFinite))].sort((a, b) => a - b);
+  if (dates.length < 3) return dates;
+  const first = dates[0];
+  const span = dates[dates.length - 1] - first;
+  // Twelve-pixel chart text plus a readable gap; browser checks measure the
+  // actual painted glyphs at several dashboard widths.
+  const separation = Math.max(...dates.map(date => formatter(date).length * 7)) + 12;
+  for (let count = Math.min(dates.length, Math.floor(availableWidth / separation) + 1); count > 2; count -= 1) {
+    const selected = Array.from({ length: count }, (_, i) => dates[Math.round(i * (dates.length - 1) / (count - 1))]);
+    if (selected.every((date, i) => i === 0 || (date - selected[i - 1]) / span * availableWidth >= separation)) return selected;
+  }
+  return [first, dates[dates.length - 1]];
+}
+
+export const getCsimPeriodFormatter = (timeGrain?: string) =>
+  new TimeFormatter({
+    id: 'csim_period',
+    label: 'CSiM reporting period',
+    formatFunc: (date: Date) => {
+      const year = date.getUTCFullYear();
+      if (timeGrain === TimeGranularity.YEAR) return String(year);
+      if (timeGrain === TimeGranularity.QUARTER) {
+        return `Q${Math.floor(date.getUTCMonth() / 3) + 1} ${year}`;
+      }
+      return getTimeFormatter('%b %Y')(date);
+    },
+  });
+
