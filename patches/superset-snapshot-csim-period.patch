+test('CSiM ticks include every reporting period', () => {
+  const months = Array.from({ length: 13 }, (_, i) => Date.UTC(2025, 8 + i, 1));
+  expect(getCsimTickValues(months)).toEqual(months);
+  expect(getCsimTickValues([months[1], months[0], months[0]])).toEqual(
+    months.slice(0, 2),
+  );
+  expect(getCsimTickValues([])).toEqual([]);
+});
+
+test.each([
+  ['2025-01-01T00:00:00Z', 'P1M', 'Jan 2025'],
+  ['2025-12-01T00:00:00Z', 'P1M', 'Dec 2025'],
+  ['2025-10-01T00:00:00Z', 'P3M', 'Q4 2025'],
+  ['2026-01-01T00:00:00Z', 'P3M', 'Q1 2026'],
+  ['2025-01-01T00:00:00Z', 'P1Y', '2025'],
+])('CSiM axis and hover agree for %s at %s', (value, grain, expected) => {
+  const date = new Date(value);
+  expect(getXAxisFormatter('csim_period', grain)?.(date)).toBe(expected);
+  expect(
+    getTooltipTimeFormatter('csim_period', grain as TimeGranularity)(date),
+  ).toBe(expected);
+});
