+import { useEffect } from 'react';
+import { DataMask, FilterState } from '@superset-ui/core';
+import { styled } from '@apache-superset/core/theme';
+
+const Fields = styled.div`
+  width: 100%;
+  display: grid;
+  gap: 10px;
+  label { display: grid; gap: 4px; font-size: 13px; }
+  input {
+    width: 100%; min-width: 0; padding: 7px 9px; border-radius: 4px;
+    border: 1px solid ${({ theme }) => theme.colorBorder};
+    background: ${({ theme }) => theme.colorBgContainer};
+    color: ${({ theme }) => theme.colorText};
+    font: inherit;
+  }
+  input:focus { outline: 2px solid ${({ theme }) => theme.colorPrimary}; }
+  p { margin: 0; font-size: 12px; line-height: 1.45; }
+  [role='alert'] { color: ${({ theme }) => theme.colorError}; }
+  button { justify-self: start; padding: 3px 0; border: 0; background: transparent; color: ${({ theme }) => theme.colorPrimary}; font: inherit; font-size: 12px; cursor: pointer; text-decoration: underline; }
+`;
+const validMonth = (value: string) => /^\d{4}-(0[1-9]|1[0-2])$/.test(value) && Number(value.slice(0, 4)) > 0 && Number(value.slice(0, 4)) < 9999;
+const monthNumber = (value: string) => Number(value.slice(0, 4)) * 12 + Number(value.slice(5)) - 1;
+const monthString = (value: number) => `${String(Math.floor(value / 12)).padStart(4, '0')}-${String(value % 12 + 1).padStart(2, '0')}`;
+const monthLabel = (value: number) => `${['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][value % 12]} ${Math.floor(value / 12)}`;
+
+// Superset evaluates this expression on every fresh dashboard load. Its UTC
+// month boundaries match these fields and keep the saved default from aging.
+export const LAST_COMPLETE_YEAR = "DATETRUNC(DATEADD(DATETIME('today'), -1, YEAR), MONTH) : DATETRUNC(DATETIME('today'), MONTH)";
+export function readMonthRange(value?: string | null): [string, string] {
+  if (value === LAST_COMPLETE_YEAR) {
+    const now = new Date();
+    const current = now.getUTCFullYear() * 12 + now.getUTCMonth();
+    return [monthString(current - 12), monthString(current - 1)];
+  }
+  const match = value?.match(/^(\d{4}-\d{2})-01 : (\d{4}-\d{2})-01$/);
+  if (!match || !validMonth(match[1]) || !validMonth(match[2])) return ['', ''];
+  return [match[1], monthString(monthNumber(match[2]) - 1)];
+}
+export function monthRangeMask(from: string, through: string): DataMask {
+  const error = !validMonth(from) || !validMonth(through)
+    ? 'Choose both months before applying.'
+    : from > through ? 'From month must be on or before Through month.' : '';
+  const range = error ? null : `${from}-01 : ${monthString(monthNumber(through) + 1)}-01`;
+  return {
+    extraFormData: range ? { time_range: range } : {},
+    filterState: { value: range, validateStatus: error ? 'error' : undefined, validateMessage: error },
+    ownState: { csimMonths: [from, through] },
+  };
+}
+export function monthCoverage(from: string, through: string, grain: string): string {
+  if (!validMonth(from) || !validMonth(through) || from > through) return '';
+  if (grain !== 'P3M' && grain !== 'P1Y') return 'Each point represents one selected month.';
+  const size = grain === 'P3M' ? 3 : 12;
+  const first = monthNumber(from), last = monthNumber(through);
+  const boundaries = [...new Set([Math.floor(first / size) * size, Math.floor(last / size) * size])];
+  const partial = boundaries.filter(start => first > start || last < start + size - 1).map(start => {
+    const label = grain === 'P3M' ? `Q${Math.floor(start % 12 / 3) + 1} ${Math.floor(start / 12)}` : String(Math.floor(start / 12));
+    const a = Math.max(start, first), b = Math.min(start + size - 1, last);
+    return `${label}: ${monthLabel(a)}${a === b ? '' : ` – ${monthLabel(b)}`} only`;
+  });
+  return partial.length ? `Partial ${grain === 'P3M' ? 'quarters' : 'years'} — ${partial.join('; ')}.` : `The selected window covers complete calendar ${grain === 'P3M' ? 'quarters' : 'years'}.`;
+}
+interface Props {
+  filterState: FilterState;
+  ownState?: { csimMonths?: [string, string] };
+  grain?: string;
+  setDataMask: (mask: DataMask) => void;
+  clearAllTrigger?: boolean;
+  onClearAllComplete?: (filterId: string) => void;
+  filterId: string;
+}
+export default function CsimMonthRange({ filterState, ownState, grain = 'P1M', setDataMask, clearAllTrigger, onClearAllComplete, filterId }: Props) {
+  const [from, through] = ownState?.csimMonths ?? readMonthRange(filterState.value);
+  const mask = monthRangeMask(from, through);
+  useEffect(() => {
+    if (clearAllTrigger) {
+      setDataMask(monthRangeMask('', ''));
+      onClearAllComplete?.(filterId);
+    }
+  }, [clearAllTrigger, setDataMask, onClearAllComplete, filterId]);
+  return <Fields aria-label="Reporting months">
+    <label>From month<input type="month" aria-label="From month" value={from} onChange={e => setDataMask(monthRangeMask(e.target.value, through))} /></label>
+    <label>Through month (inclusive)<input type="month" aria-label="Through month (inclusive)" value={through} onChange={e => setDataMask(monthRangeMask(from, e.target.value))} /></label>
+    {mask.filterState?.validateMessage ? <p role="alert">{mask.filterState.validateMessage}</p> : <p role="status">{monthCoverage(from, through, grain)}</p>}
+    {filterState.value === LAST_COMPLETE_YEAR && <p>Last 12 complete months</p>}
+    <p>Apply filters to update the charts.</p>
+    <button type="button" onClick={() => setDataMask(monthRangeMask('', ''))}>Clear months</button>
+  </Fields>;
+}
