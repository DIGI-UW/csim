dashboard.csim.uwdigi.org {
    redir / /superset/dashboard/csim-individual-reconciled-months/ 302
    reverse_proxy csim-main-v2:8088 {
        transport http {
            keepalive 1s
        }
    }
}
csim.uwdigi.org {
    redir https://dashboard.csim.uwdigi.org{uri} 308
}
preview.csim.uwdigi.org {
    redir / /superset/dashboard/csim-individual-preview/ 302
    reverse_proxy csim-preview-v2:8088 {
        transport http {
            keepalive 1s
        }
    }
}
design.csim.uwdigi.org {
    root * /srv/media/csim-design-v2
    header Cache-Control "no-cache"
    file_server
}

standard.csim.uwdigi.org {
    redir / /superset/dashboard/csim-individual-standard-month-selectors/ 302
    @retired_main path /superset/dashboard/csim-individual-standard /superset/dashboard/csim-individual-standard/ /superset/dashboard/csim-individual-standard-sortable /superset/dashboard/csim-individual-standard-sortable/
    redir @retired_main /superset/dashboard/csim-individual-standard-month-selectors/ 302
    @retired_examples path /superset/dashboard/csim-standard-examples /superset/dashboard/csim-standard-examples/ /superset/dashboard/csim-standard-sortable-examples /superset/dashboard/csim-standard-sortable-examples/
    redir @retired_examples /superset/dashboard/csim-standard-month-selectors-examples/ 302
    reverse_proxy csim-standard:8088
}
